# Every environment variable the app reads in production (53.1.6.1).
#
# Local dev: copy this file to .env and fill in the values.
# Vercel: set each one under Project -> Settings -> Environment Variables,
# scoped to Production. Setup steps for every service below:
#   .github/docs/deployment-runbook.md
#
# Vercel applies env changes only to new deployments, so redeploy after
# editing any of them. NEXT_PUBLIC_* values are also inlined into the build
# itself, so they must be set before the build runs.

# --- Database ------------------------------------------------------------

# Postgres connection string (src/lib/prisma.ts). On Vercel this is Neon's
# pooled URL (the host contains "-pooler"). `prisma migrate deploy` reads
# this same variable (prisma7.config.ts), so run migrations with Neon's
# direct URL set inline for that one command instead. See the runbook.
# Missing: no error at boot; the first query fails.
DATABASE_URL=

# --- Stripe ---------------------------------------------------------------
# Test-mode keys (sk_test_/pk_test_) on staging and locally; live keys
# (sk_live_/pk_live_) only at go-live (53.3). Never mix modes: the secret
# key, publishable key and webhook secret must all come from the same mode.

# Server API key (src/lib/stripe.ts). Missing: throws when the module loads,
# so every route that imports it fails.
STRIPE_SECRET_KEY=

# Browser key for Stripe Elements (src/lib/stripe-client.ts). Inlined at
# build time. Missing: the payment form fails to load in the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Signing secret (whsec_) of the webhook endpoint pointed at
# /api/webhooks/stripe. Locally, `stripe listen` prints one. Missing: every
# webhook is answered 400 and Stripe keeps retrying.
STRIPE_WEBHOOK_SECRET=

# --- UploadThing ----------------------------------------------------------

# Read by the UploadThing SDK for /api/uploadthing (reference images).
# Dashboard -> your app -> API Keys. Use a separate app per environment.
# Missing: uploads fail with "Missing token".
UPLOADTHING_TOKEN=

# --- Resend (sign-in and booking email codes) ----------------------------

# Resend API key (re_), sending access only (src/lib/resend.ts). Missing:
# throws when the module loads, so every route that loads the email-code
# auth actions fails, not only the send itself.
RESEND_API_KEY=

# Sender for verification emails, on a domain verified in Resend, e.g.
#   Vettr <no-reply@vettr.studio>
# Missing: nothing throws. Each send logs missing_email_from_env and no
# code reaches the user.
EMAIL_FROM=

# --- Scheduler ------------------------------------------------------------

# Bearer token the scheduler (GitHub Actions) sends to
# POST /api/cron/session-cleanup (CLAUDE.md 27.4) and
# POST /api/cron/deposit-refund-retry (56.7). Generate with:
#   openssl rand -hex 32
# The same value is also the CRON_SECRET GitHub repo secret, next to the
# APP_URL repo secret. Missing: every cron call is answered 401.
CRON_SECRET=

# --- App URL --------------------------------------------------------------

# Public origin of this deployment, no trailing slash, e.g.
#   https://staging.vettr.studio
# Used for metadataBase (src/app/layout.tsx) and the Stripe Connect
# onboarding return/refresh URLs. Inlined at build time. Missing: silently
# falls back to http://localhost:3000, so those links point at localhost.
NEXT_PUBLIC_APP_URL=

# --- Local development and tests only (never set on Vercel) --------------

# Diverts verification emails to a JSONL file instead of Resend. Playwright
# sets it for e2e runs. Ignored when NODE_ENV=production.
# EMAIL_CAPTURE_SINK_PATH=
