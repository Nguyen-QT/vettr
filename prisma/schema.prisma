// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  PENDING
  // Artist proposed a duration that spills into a second slot; awaiting
  // off-platform confirmation with the client before the booking is
  // finalized (CLAUDE.md 4.1f/4.1g).
  AWAITING_SLOT_CONFIRMATION
  APPROVED
  DECLINED
  // Client self-cancelled via the client dashboard (CLAUDE.md 5.4/5.6).
  // Renamed from the original plain CANCELLED value -- see this
  // migration's SQL for the RENAME VALUE that carries existing rows
  // forward instead of losing their history.
  CANCELLED_BY_CLIENT
  // Artist cancelled an already-APPROVED booking (CLAUDE.md 5.6). Never
  // counts as a client cancellation offense -- it's the artist's call,
  // not the client's fault.
  CANCELLED_BY_ARTIST
  // Artist marked a past-dated APPROVED appointment as a no-show
  // (CLAUDE.md 5.6). Counts as a client cancellation offense.
  NO_SHOW
  COMPLETED
}

enum SlotStatus {
  REQUESTED
  BOOKED
  RELEASED
}

enum ComplexityTier {
  TIER_2
  TIER_3
  TIER_4
  FREESTYLE
}

enum AccountRole {
  ARTIST
  CLIENT
}

// Shared login identity for both roles (CLAUDE.md 5.1/5.2) -- one auth
// codepath regardless of whether the account is an artist or a client.
// Exactly one of artistId/clientProfileId is set, matching role; that
// pairing is an application-level rule (see the auth domain service),
// not something this schema itself enforces.
model Account {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  role         AccountRole
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  artist   Artist? @relation(fields: [artistId], references: [id])
  artistId String? @unique

  clientProfile   ClientProfile? @relation(fields: [clientProfileId], references: [id])
  clientProfileId String?        @unique

  sessions Session[]
}

// DB-backed so a session can actually be revoked (logout, or a future
// "sign out everywhere") rather than just expiring client-side, unlike
// a bare signed JWT.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
}

model Artist {
  id              String   @id @default(cuid())
  name            String
  instagramHandle String   @unique
  email           String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Public directory card fields (CLAUDE.md 5.3) -- nullable since an
  // artist without these set simply doesn't show them on their card.
  // Read-only for clients; artist-facing management is a backlog item,
  // same as TierReferenceImage -- seeded via Prisma Studio for now.
  avatarUrl String?
  bio       String?
  location  String?

  account             Account?
  bookingRequests     BookingRequest[]
  timeSlots           TimeSlot[]
  weeklyHours         ArtistWeeklyHours[]
  scheduleOverrides   ArtistScheduleOverride[]
  tierReferenceImages TierReferenceImage[]
  depositSettings     ArtistDepositSetting[]
}

// Recurring weekly availability (CLAUDE.md 4.3). No row for a given
// artistId/dayOfWeek means that day defaults to fully open (all of
// DAILY_SLOT_TIME_OPTIONS) -- getOperatingWindows is what actually
// enforces the default-open fallback, not the schema.
model ArtistWeeklyHours {
  id             String   @id @default(cuid())
  dayOfWeek      Int
  availableTimes String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  artist   Artist @relation(fields: [artistId], references: [id])
  artistId String

  @@unique([artistId, dayOfWeek])
}

// One-off overrides for a specific date (CLAUDE.md 4.3), taking
// precedence over ArtistWeeklyHours when present. An empty
// availableTimes array is a full blackout for that date.
model ArtistScheduleOverride {
  id             String   @id @default(cuid())
  date           DateTime @db.Date
  availableTimes String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  artist   Artist @relation(fields: [artistId], references: [id])
  artistId String

  @@unique([artistId, date])
}

// One artist's own past-work example images, grouped by tier (CLAUDE.md
// 4.6), shown to clients on the booking form to help them judge which
// tier fits their idea -- per-artist rather than a shared/generic
// gallery, since clients are judging this specific artist's style and
// pricing. Read-only for clients; artist upload/management is a
// backlog item, so rows are seeded via Prisma Studio for now.
model TierReferenceImage {
  id        String         @id @default(cuid())
  tier      ComplexityTier
  imageUrl  String
  createdAt DateTime       @default(now())

  artist   Artist @relation(fields: [artistId], references: [id])
  artistId String

  @@index([artistId, tier])
}

// Per-tier deposit amount an artist requires before a booking is
// considered secured (CLAUDE.md 7.1). No row for a given
// artistId/tier means no deposit is required for that tier yet --
// getArtistDepositSettings is what actually enforces that default,
// same "no config = default open" precedent as ArtistWeeklyHours.
model ArtistDepositSetting {
  id            String         @id @default(cuid())
  tier          ComplexityTier
  depositAmount Decimal        @db.Decimal(10, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  artist   Artist @relation(fields: [artistId], references: [id])
  artistId String

  @@unique([artistId, tier])
}

// Tracks cancellation history and the resulting precharge flag (CLAUDE.md
// "Flagging Mechanism"). cancellationCount/enforcePrecharge are toggled by
// the billing domain service, not derived at query time.
model ClientProfile {
  id                String   @id @default(cuid())
  instagramHandle   String   @unique
  email             String
  phone             String?
  cancellationCount Int      @default(0)
  enforcePrecharge  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Onboarding fields (CLAUDE.md 6.2) -- nullable at the DB level only,
  // same reasoning as BookingRequest.requestedStartTime/estimatedPrice:
  // "required" is enforced by booking.schema.ts for every new
  // submission, not by a backfilled placeholder value on existing
  // rows. dateOfBirth rather than a raw age so exact current age is
  // always derivable instead of a stored value quietly going stale.
  firstName   String?
  lastName    String?
  dateOfBirth DateTime? @db.Date

  account         Account?
  bookingRequests BookingRequest[]
}

model BookingRequest {
  id     String        @id @default(cuid())
  status RequestStatus @default(PENDING)

  client   ClientProfile @relation(fields: [clientId], references: [id])
  clientId String

  artist   Artist @relation(fields: [artistId], references: [id])
  artistId String

  // Real time-slot allocations for this request -- always BOOKED, created
  // only once the artist approves (CLAUDE.md "No Auto-Booking"). The
  // client's own preference lives in requestedStartTime below, a plain
  // field rather than a TimeSlot row, since no allocation exists yet.
  timeSlots TimeSlot[]

  // Client's chosen slot at booking time (one of the artist's fixed daily
  // times, e.g. 11:00/14:00/17:30, on a client-picked date). Not itself an
  // allocation -- see timeSlots above. Nullable at the DB level only
  // because booking capture (CLAUDE.md 4.1e) hasn't landed yet, same as
  // estimatedPrice below -- booking.schema.ts is what actually enforces it
  // once that lands.
  requestedStartTime DateTime?

  // Set when the artist's chosen duration spills into a second slot
  // (status becomes AWAITING_SLOT_CONFIRMATION); holds the proposal until
  // the artist confirms off-platform with the client and finalizes the
  // booking. Unused for a single-slot approval, which books immediately.
  proposedDurationMinutes Int?

  designReferences DesignReference[]
  addons           Addon[]

  tier          ComplexityTier
  minPrice      Decimal        @db.Decimal(10, 2)
  maxPrice      Decimal        @db.Decimal(10, 2)
  designTags    String[]
  aestheticTags String[]

  // Null until the artist triages the request and sets a base estimate;
  // the client does not supply a price at booking time.
  estimatedPrice Decimal? @db.Decimal(10, 2)
  depositPaid    Boolean  @default(false)

  // Deposit payment (CLAUDE.md 7.1). depositAmount is a snapshot taken
  // when the PaymentIntent is created -- deliberately decoupled from
  // the live ArtistDepositSetting for this request's tier, so a later
  // change to the artist's per-tier amount never retroactively alters
  // an in-flight or already-paid request. stripePaymentIntentId is set
  // at the same time; depositPaid above flips true once the webhook
  // confirms the PaymentIntent succeeded.
  depositAmount         Decimal? @db.Decimal(10, 2)
  stripePaymentIntentId String?

  clientNotes String?

  // Optional, purely advisory (CLAUDE.md 6.3) -- a client-flagged "must
  // be finished by" time for the artist to weigh when deciding
  // duration/slot count during review. Never auto-enforced or
  // blocking, matching "No Auto-Booking": the artist always has final
  // say over the actual duration and slot allocation.
  clientMaxEndTime DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Visual Enforcement: every BookingRequest must carry at least one high-res
// design reference image. The one-or-more minimum is a domain-service
// validation rule (Phase 2), not something the schema itself can enforce.
model DesignReference {
  id        String   @id @default(cuid())
  imageUrl  String
  createdAt DateTime @default(now())

  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  bookingRequestId String
}

// Line-item add-ons applied dynamically on the day of service, layered on
// top of the base estimatedPrice for the final bill.
model Addon {
  id        String   @id @default(cuid())
  label     String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  bookingRequestId String
}

// No Auto-Booking: rows here are only ever created already BOOKED, by
// the artist's approval action (see confirmTimeSlot) -- the client's own
// slot preference is BookingRequest.requestedStartTime, a plain field,
// not a row here. REQUESTED/RELEASED remain on SlotStatus for a future
// cancellation flow (Phase 4.4) that would transition a BOOKED row back
// out rather than delete it.
model TimeSlot {
  id        String     @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  status    SlotStatus @default(REQUESTED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  artist   Artist @relation(fields: [artistId], references: [id])
  artistId String

  bookingRequest   BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  bookingRequestId String

  @@index([artistId, startTime])
}
